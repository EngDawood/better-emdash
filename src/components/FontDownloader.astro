---
/**
 * Live font-download panel for the thmanyah-font-web project page.
 *
 * Ported from the repo's own demo (`examples/demo.html`): the binaries are
 * fetched from jsDelivr and, when more than one is picked, packed in the
 * browser by a small store-only ZIP writer -- woff2/otf are already
 * compressed, so deflate would buy nothing and a ZIP library would cost a
 * download.
 *
 * Rendered where the `{{font-downloader}}` marker sits in the entry body, so
 * the position stays editable from the EmDash admin.
 */
import { t, type Locale } from "../i18n/utils";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;

// Pinned to the commit that carries both formats (1b66bb7). Immutable and
// cached forever at the edge -- never point this at a branch.
const CDN =
	"https://cdn.jsdelivr.net/gh/engdawood/thmanyah-font-web@1b66bb721f771d12ef36e61c128b7a5c668ccf89/fonts";

const families = [
	{ slug: "thmanyah-sans", label: t("fontDownload.familySans", locale) },
	{
		slug: "thmanyah-serif-display",
		label: t("fontDownload.familySerifDisplay", locale),
	},
	{
		slug: "thmanyah-serif-text",
		label: t("fontDownload.familySerifText", locale),
	},
];

const weights = [
	{ value: "300", name: "Light" },
	{ value: "400", name: "Regular" },
	{ value: "500", name: "Medium" },
	{ value: "700", name: "Bold" },
	{ value: "900", name: "Black" },
];

const formats = [
	{ value: "woff2", label: "WOFF2", hint: t("fontDownload.hintWeb", locale) },
	{ value: "otf", label: "OTF", hint: t("fontDownload.hintDesktop", locale) },
	{ value: "both", label: t("fontDownload.both", locale), hint: "" },
];
---

<section
	class="fd"
	data-font-downloader
	data-cdn={CDN}
	data-msg-empty={t("fontDownload.empty", locale)}
	data-msg-failed={t("fontDownload.failed", locale)}
	data-msg-files={t("fontDownload.files", locale)}
	aria-labelledby="fd-title"
>
	<div class="fd-head">
		<span class="fd-kicker">{t("fontDownload.kicker", locale)}</span>
		<h3 class="fd-title" id="fd-title">{t("fontDownload.title", locale)}</h3>
	</div>

	<div class="fd-controls">
		<div class="fd-field">
			<label class="fd-label" for="fd-family">{t("fontDownload.family", locale)}</label>
			<select class="fd-select" id="fd-family" data-family>
				{families.map((f) => <option value={f.slug}>{f.label}</option>)}
			</select>
		</div>

		<div class="fd-field">
			<span class="fd-label">{t("fontDownload.format", locale)}</span>
			<div class="fd-chips" role="radiogroup" aria-label={t("fontDownload.format", locale)}>
				{
					formats.map((f) => (
						<label class="fd-chip">
							<input
								type="radio"
								name="fd-format"
								value={f.value}
								checked={f.value === "woff2"}
								data-format
							/>
							<span class="fd-chip-body">
								<span class="fd-chip-label">{f.label}</span>
								{f.hint && <span class="fd-chip-hint">{f.hint}</span>}
							</span>
						</label>
					))
				}
			</div>
		</div>

		<div class="fd-field">
			<span class="fd-label">{t("fontDownload.weights", locale)}</span>
			<div class="fd-chips">
				{
					weights.map((w) => (
						<label class="fd-chip">
							<input
								type="checkbox"
								value={w.value}
								checked={w.value === "400"}
								data-weight
								data-name={w.name}
							/>
							<span class="fd-chip-body">
								<span class="fd-chip-label">{w.value}</span>
								<span class="fd-chip-hint">{w.name}</span>
							</span>
						</label>
					))
				}
			</div>
		</div>
	</div>

	<div class="fd-readout" data-readout dir="ltr">thmanyah-sans-Regular.woff2</div>

	<div class="fd-actions">
		<button type="button" class="fd-btn fd-btn--primary" data-download-selected>
			{t("fontDownload.selected", locale)}
		</button>
		<button type="button" class="fd-btn" data-download-family>
			{t("fontDownload.wholeFamily", locale)}
		</button>
		<span class="fd-status" data-status role="status" aria-live="polite"></span>
	</div>

	<p class="fd-license">
		{t("fontDownload.license", locale)}{" "}
		<a href="https://font.thmanyah.com/licenses" target="_blank" rel="noopener noreferrer">
			{t("fontDownload.licenseLink", locale)}
		</a>
	</p>
</section>

<script>
	// Casts rather than `querySelector<T>` generics throughout: the Worker
	// globals in scope redefine `Element` (HTMLRewriter's), so the DOM generic
	// constraint does not hold here.
	const root = document.querySelector("[data-font-downloader]") as HTMLElement | null;

	if (root) {
		const CDN = root.dataset.cdn ?? "";
		const MSG = {
			empty: root.dataset.msgEmpty ?? "",
			failed: root.dataset.msgFailed ?? "",
			files: root.dataset.msgFiles ?? "",
		};

		const familySel = root.querySelector("[data-family]") as unknown as HTMLSelectElement;
		const formatRadios = [...root.querySelectorAll("[data-format]")] as HTMLInputElement[];
		const weightBoxes = [...root.querySelectorAll("[data-weight]")] as HTMLInputElement[];
		const readout = root.querySelector("[data-readout]") as HTMLElement;
		const statusEl = root.querySelector("[data-status]") as HTMLElement;
		const selBtn = root.querySelector("[data-download-selected]") as HTMLButtonElement;
		const famBtn = root.querySelector("[data-download-family]") as HTMLButtonElement;
		const buttons = [selBtn, famBtn];

		const currentFormats = () => {
			const picked = formatRadios.find((r) => r.checked)?.value ?? "woff2";
			return picked === "both" ? ["woff2", "otf"] : [picked];
		};
		const checkedWeights = () =>
			weightBoxes.filter((b) => b.checked).map((b) => ({ value: b.value, name: b.dataset.name! }));
		const allWeights = () =>
			weightBoxes.map((b) => ({ value: b.value, name: b.dataset.name! }));

		const fileName = (slug: string, fmt: string, weightName: string) =>
			`${slug}-${weightName}.${fmt}`;

		function syncReadout() {
			const slug = familySel.value;
			const fmts = currentFormats();
			const picked = checkedWeights();

			if (picked.length === 0) {
				readout.textContent = MSG.empty;
				return;
			}

			const names = fmts.flatMap((f) => picked.map((w) => fileName(slug, f, w.name)));
			readout.textContent =
				names.length === 1 ? names[0] : `${names[0]}  +${names.length - 1}`;
		}

		function setStatus(msg: string, ok = false) {
			statusEl.textContent = msg;
			statusEl.classList.toggle("is-ok", ok);
		}

		const kb = (n: number) =>
			n < 1048576 ? `${Math.round(n / 1024)} KB` : `${(n / 1048576).toFixed(1)} MB`;

		function saveBlob(blob: Blob, name: string) {
			const url = URL.createObjectURL(blob);
			const a = document.createElement("a");
			a.href = url;
			a.download = name;
			document.body.appendChild(a);
			a.click();
			a.remove();
			setTimeout(() => URL.revokeObjectURL(url), 10000);
		}

		async function fetchFont(url: string) {
			const res = await fetch(url);
			if (!res.ok) throw new Error(`${res.status} ${url}`);
			return new Uint8Array(await res.arrayBuffer());
		}

		/* Store-only ZIP writer -- woff2/otf are already compressed, so there is
		   nothing for deflate to win and no library worth loading. */
		const CRC_TABLE = (() => {
			const table = new Uint32Array(256);
			for (let i = 0; i < 256; i++) {
				let c = i;
				for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
				table[i] = c >>> 0;
			}
			return table;
		})();

		function crc32(bytes: Uint8Array) {
			let c = 0xffffffff;
			for (let i = 0; i < bytes.length; i++) c = CRC_TABLE[(c ^ bytes[i]) & 0xff] ^ (c >>> 8);
			return (c ^ 0xffffffff) >>> 0;
		}

		function buildZip(entries: Array<{ name: string; bytes: Uint8Array }>) {
			const enc = new TextEncoder();
			const locals: Uint8Array[] = [];
			const centrals: Uint8Array[] = [];
			let offset = 0;

			for (const entry of entries) {
				const nameBytes = enc.encode(entry.name);
				const crc = crc32(entry.bytes);
				const size = entry.bytes.length;

				const local = new Uint8Array(30 + nameBytes.length);
				const lv = new DataView(local.buffer);
				lv.setUint32(0, 0x04034b50, true);
				lv.setUint16(4, 20, true); // version needed
				lv.setUint16(6, 0x0800, true); // UTF-8 names
				lv.setUint16(8, 0, true); // stored
				lv.setUint16(10, 0, true); // time
				lv.setUint16(12, 0x21, true); // date -> 1980-01-01
				lv.setUint32(14, crc, true);
				lv.setUint32(18, size, true);
				lv.setUint32(22, size, true);
				lv.setUint16(26, nameBytes.length, true);
				local.set(nameBytes, 30);

				const central = new Uint8Array(46 + nameBytes.length);
				const cv = new DataView(central.buffer);
				cv.setUint32(0, 0x02014b50, true);
				cv.setUint16(4, 20, true); // version made by
				cv.setUint16(6, 20, true); // version needed
				cv.setUint16(8, 0x0800, true);
				cv.setUint16(10, 0, true);
				cv.setUint16(12, 0, true);
				cv.setUint16(14, 0x21, true);
				cv.setUint32(16, crc, true);
				cv.setUint32(20, size, true);
				cv.setUint32(24, size, true);
				cv.setUint16(28, nameBytes.length, true);
				cv.setUint32(42, offset, true); // local header offset
				central.set(nameBytes, 46);

				locals.push(local, entry.bytes);
				centrals.push(central);
				offset += local.length + size;
			}

			const centralSize = centrals.reduce((n, c) => n + c.length, 0);
			const end = new Uint8Array(22);
			const ev = new DataView(end.buffer);
			ev.setUint32(0, 0x06054b50, true);
			ev.setUint16(8, entries.length, true);
			ev.setUint16(10, entries.length, true);
			ev.setUint32(12, centralSize, true);
			ev.setUint32(16, offset, true);

			return new Blob([...locals, ...centrals, end] as unknown as BlobPart[], {
				type: "application/zip",
			});
		}

		async function run(weights: Array<{ value: string; name: string }>) {
			if (weights.length === 0) {
				setStatus(MSG.empty);
				return;
			}

			const slug = familySel.value;
			const fmts = currentFormats();
			const jobs = fmts.flatMap((fmt) =>
				weights.map((w) => ({
					fmt,
					url: `${CDN}/${slug}/${fmt}/${fileName(slug, fmt, w.name)}`,
					zipPath: `${slug}/${fmt}/${fileName(slug, fmt, w.name)}`,
					name: fileName(slug, fmt, w.name),
				}))
			);

			buttons.forEach((b) => (b.disabled = true));

			try {
				// A single file goes out as the raw font -- no zip wrapper.
				if (jobs.length === 1) {
					setStatus("…");
					const bytes = await fetchFont(jobs[0].url);
					saveBlob(
						new Blob([bytes] as unknown as BlobPart[], { type: `font/${jobs[0].fmt}` }),
						jobs[0].name
					);
					setStatus(`✓ ${kb(bytes.length)}`, true);
					return;
				}

				const entries: Array<{ name: string; bytes: Uint8Array }> = [];
				let total = 0;

				for (const job of jobs) {
					setStatus(`${entries.length}/${jobs.length} …`);
					const bytes = await fetchFont(job.url);
					entries.push({ name: job.zipPath, bytes });
					total += bytes.length;
				}

				const suffix = fmts.length === 2 ? "woff2-otf" : fmts[0];
				const zipName =
					weights.length === weightBoxes.length
						? `${slug}-${suffix}.zip`
						: `${slug}-${weights.map((w) => w.name).join("-")}-${suffix}.zip`;

				saveBlob(buildZip(entries), zipName);
				setStatus(`✓ ${jobs.length} ${MSG.files} · ${kb(total)}`, true);
			} catch (err) {
				console.error(err);
				setStatus(`✕ ${MSG.failed}`);
			} finally {
				buttons.forEach((b) => (b.disabled = false));
				setTimeout(() => setStatus(""), 6000);
			}
		}

		[familySel, ...formatRadios, ...weightBoxes].forEach((el) =>
			el.addEventListener("change", syncReadout)
		);

		selBtn.addEventListener("click", () => run(checkedWeights()));
		famBtn.addEventListener("click", () => run(allWeights()));

		syncReadout();
	}
</script>

<style>
	.fd {
		--fd-ui: var(--font-sans);
		margin: 2.5em 0;
		padding: var(--spacing-6);
		background: var(--color-bg-subtle);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
		font-size: var(--font-size-base);
		line-height: 1.6;
	}

	:global(html[dir="rtl"]) .fd {
		--fd-ui: var(--font-arabic-sans);
	}

	.fd-head {
		margin-bottom: var(--spacing-6);
	}

	.fd-kicker {
		display: block;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.fd-title {
		margin: var(--spacing-2) 0 0;
		font-family: var(--fd-ui);
		font-size: 18px;
		font-weight: 600;
		line-height: 1.5;
		color: var(--color-text);
	}

	.fd-controls {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-5);
	}

	.fd-label {
		display: block;
		margin-bottom: var(--spacing-2);
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.fd-select {
		width: 100%;
		max-width: 320px;
		padding: 9px 12px;
		font-family: var(--fd-ui);
		font-size: 15px;
		color: var(--color-text);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		cursor: pointer;
	}

	.fd-select:focus-visible,
	.fd-chip:focus-within {
		outline: 2px solid var(--color-accent-ring);
		outline-offset: 2px;
	}

	.fd-chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
	}

	.fd-chip {
		position: relative;
		cursor: pointer;
	}

	/* The input stays focusable but never paints -- the chip body is the control. */
	.fd-chip input {
		position: absolute;
		inset: 0;
		opacity: 0;
		margin: 0;
		cursor: pointer;
	}

	.fd-chip-body {
		display: flex;
		align-items: baseline;
		gap: 6px;
		padding: 7px 12px;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		transition:
			color var(--transition-fast),
			border-color var(--transition-fast),
			background var(--transition-fast);
	}

	.fd-chip-label {
		font-family: var(--font-mono);
		font-size: 12.5px;
		color: var(--color-text);
	}

	.fd-chip-hint {
		font-family: var(--fd-ui);
		font-size: 11.5px;
		color: var(--color-muted);
	}

	.fd-chip:hover .fd-chip-body {
		border-color: var(--color-muted);
	}

	.fd-chip input:checked + .fd-chip-body {
		background: var(--color-accent);
		border-color: var(--color-accent);
	}

	.fd-chip input:checked + .fd-chip-body .fd-chip-label,
	.fd-chip input:checked + .fd-chip-body .fd-chip-hint {
		color: var(--color-on-accent);
	}

	.fd-readout {
		margin-top: var(--spacing-5);
		padding: 10px 12px;
		background: var(--color-surface);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius);
		font-family: var(--font-mono);
		font-size: 12.5px;
		line-height: 1.5;
		color: var(--color-text-secondary);
		overflow-x: auto;
		white-space: nowrap;
		text-align: left;
	}

	.fd-actions {
		margin-top: var(--spacing-4);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-3);
	}

	.fd-btn {
		font-family: var(--fd-ui);
		font-size: 13px;
		font-weight: 600;
		padding: 10px 18px;
		background: transparent;
		color: var(--color-text);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		cursor: pointer;
		transition:
			background var(--transition-fast),
			border-color var(--transition-fast),
			opacity var(--transition-fast);
	}

	.fd-btn:hover:not(:disabled) {
		border-color: var(--color-muted);
	}

	.fd-btn--primary {
		background: var(--color-accent);
		color: var(--color-on-accent);
		border-color: var(--color-accent);
	}

	.fd-btn--primary:hover:not(:disabled) {
		background: var(--color-accent-hover);
		border-color: var(--color-accent-hover);
	}

	.fd-btn:disabled {
		opacity: 0.5;
		cursor: default;
	}

	.fd-status {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-muted);
	}

	.fd-status.is-ok {
		color: var(--color-accent);
	}

	.fd-license {
		margin: var(--spacing-5) 0 0;
		font-family: var(--fd-ui);
		font-size: 12.5px;
		line-height: 1.6;
		color: var(--color-muted);
	}

	.fd-license a {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (max-width: 640px) {
		.fd {
			padding: var(--spacing-5);
		}

		.fd-actions .fd-btn {
			flex: 1 1 auto;
		}
	}
</style>
