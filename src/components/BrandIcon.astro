const aliases: Record<string, string> = {
	node: "node.js",
	nodejs: "node.js",
	ts: "typescript",
	workers: "cloudflare workers",
	"mcp server": "mcp",
	"mcp server live": "mcp",
};

const key = name.trim().toLowerCase();
const brand = brands[key] ?? brands[aliases[key] ?? ""];
---

{
	brand && (
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox={brand.viewBox ?? "0 0 24 24"}
			fill={brand.stroke ? "none" : "currentColor"}
			stroke={brand.stroke ? "currentColor" : undefined}
			stroke-width={brand.stroke}
			stroke-linecap={brand.stroke ? "round" : undefined}
			aria-hidden="true"
			focusable="false"
			class={className}
			set:html={brand.paths}
		/>
	)
}

<style>
	/* Sized/colored by the parent via inherited custom properties —
	   scoped class names from a parent component cannot reach this element. */
	svg {
		width: var(--brand-icon-size, 1em);
		height: var(--brand-icon-size, 1em);
		color: var(--brand-icon-color, currentColor);
		flex: none;
	}
</style>
