---
import { getEmDashCollection, getEmDashEntry, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import { t, type Locale } from "../i18n/utils";
import { submitContactForm } from "../utils/contact-form";
import HeroSection from "./sections/HeroSection.astro";
import WorkSection from "./sections/WorkSection.astro";
import WritingSection from "./sections/WritingSection.astro";
import AboutSection from "./sections/AboutSection.astro";
import ContactSection from "./sections/ContactSection.astro";
import FaqTeaserSection from "./sections/FaqTeaserSection.astro";
import ScrollReveal from "./ScrollReveal.astro";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;

const [settings, { entries: projects, cacheHint }, { entries: posts }, { entry: faqPage, cacheHint: faqCacheHint }] = await Promise.all([
	getSiteSettings(),
	getEmDashCollection("projects", { locale, orderBy: { published_at: "desc" }, limit: 3 }),
	getEmDashCollection("posts", { locale, orderBy: { published_at: "desc" }, limit: 4 }),
	getEmDashEntry("pages", "faq", { locale }),
]);
Astro.cache.set(cacheHint);
Astro.cache.set(faqCacheHint);

// Pull the FAQ items out of the marketing.faq block for the homepage teaser
const faqBlock = faqPage?.data.content?.find(
	(block: { _type: string }) => block._type === "marketing.faq",
) as { items?: { question: string; answer: string }[] } | undefined;
const faqItems: { question: string; answer: string }[] = faqBlock?.items ?? [];

// Projects and posts are already sorted and limited by the query
const featuredProjects = projects;
const recentPosts = posts;

const email = "eng.dawoodsaleh@gmail.com";
const telegram = "https://t.me/Daw5d";
const github = settings.social?.github ?? "https://github.com/EngDawood";
const linkedin = settings.social?.linkedin ?? "https://www.linkedin.com/in/dawood3";
const twitter = settings.social?.twitter ?? "https://x.com/dawo5d";

// Contact form state
let formStatus: "idle" | "success" | "error" = "idle";
let formMessage = "";

if (Astro.request.method === "POST") {
	const formData = await Astro.request.formData().catch(() => null);
	const name = formData?.get("name")?.toString() || "";
	const emailVal = formData?.get("email")?.toString() || "";
	const message = formData?.get("message")?.toString() || "";

	if (!name || !emailVal || !emailVal.includes("@") || !message) {
		formStatus = "error";
		formMessage = t("contact.form.error", locale);
	} else {
		const result = await submitContactForm(Astro.url, "contact", {
			name,
			email: emailVal,
			message,
		});
		formStatus = result.status;
		formMessage =
			result.message ??
			t(result.status === "success" ? "contact.form.success" : "contact.form.error", locale);
	}
}
---

<Base
	title={t("meta.title", locale)}
	description={t("meta.description", locale)}
	locale={locale}
>
	<HeroSection
		locale={locale}
		email={email}
	/>

	<WorkSection
		featuredProjects={featuredProjects}
		locale={locale}
	/>

	<WritingSection
		recentPosts={recentPosts}
		locale={locale}
	/>

	<AboutSection
		locale={locale}
		email={email}
	/>

	<ContactSection
		locale={locale}
		email={email}
		github={github}
		linkedin={linkedin}
		telegram={telegram}
		twitter={twitter}
		formStatus={formStatus}
		formMessage={formMessage}
	/>

	<FaqTeaserSection
		faqItems={faqItems}
		locale={locale}
	/>

	<ScrollReveal />
</Base>
