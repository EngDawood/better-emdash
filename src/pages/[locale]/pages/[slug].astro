---
import { getEmDashEntry } from "emdash";
import MarketingBlocks from "../../../components/MarketingBlocks.astro";
import Base from "../../../layouts/Base.astro";
import { locales, type Locale, defaultLocale } from "../../../i18n/utils";

const { locale: localeParam, slug } = Astro.params;
const locale: Locale = locales.includes(localeParam as Locale)
	? (localeParam as Locale)
	: defaultLocale;

if (!locales.includes(localeParam as Locale)) {
	return Astro.redirect(`/${defaultLocale}/pages/${slug}`, 302);
}

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug, { locale });

if (!page) {
	return Astro.rewrite("/404");
}

Astro.cache.set(cacheHint);
---

<Base
	title={page.data.title}
	content={{ collection: "pages", id: page.data.id, slug }}
	locale={locale}
>
	<article class="page-article">
		<header class="page-header">
			<h1 class="page-title" {...page.edit.title}>{page.data.title}</h1>
		</header>

		<div class="page-content" dir="auto">
			<MarketingBlocks value={page.data.content || []} />
		</div>
	</article>
</Base>

<style>
	.page-article {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6);
	}

	.page-header {
		margin-bottom: var(--spacing-8);
	}

	.page-title {
		font-family: var(--font-serif);
		font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-4xl));
		font-weight: 500;
		line-height: var(--leading-tight);
		letter-spacing: -0.02em;
	}

	.page-content :global(p) {
		margin-bottom: 1.5em;
		unicode-bidi: plaintext;
	}

	.page-content :global(h2) {
		font-family: var(--font-serif);
		font-size: var(--font-size-2xl);
		font-weight: 500;
		margin-top: 2em;
		margin-bottom: 0.75em;
		unicode-bidi: plaintext;
	}

	.page-content :global(h3) {
		font-family: var(--font-serif);
		font-size: var(--font-size-xl);
		font-weight: 500;
		margin-top: 1.75em;
		margin-bottom: 0.5em;
		unicode-bidi: plaintext;
	}

	.page-content :global(blockquote) {
		margin: 1.5em 0;
		padding-inline-start: var(--spacing-6);
		border-inline-start: 3px solid var(--color-accent-muted);
		color: var(--color-muted);
		font-family: var(--font-serif);
		font-style: italic;
	}

	.page-content :global(pre) {
		margin: 1.5em 0;
		padding: var(--spacing-4);
		background: var(--color-surface);
		border-radius: var(--radius);
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
	}

	.page-content :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--color-surface);
		padding: 0.15em 0.3em;
		border-radius: var(--radius);
	}

	.page-content :global(pre code) {
		background: none;
		padding: 0;
	}

	.page-content :global(ul),
	.page-content :global(ol) {
		margin-bottom: 1.5em;
		padding-left: var(--spacing-5);
	}

	.page-content :global(li) {
		margin-bottom: 0.5em;
	}
</style>
