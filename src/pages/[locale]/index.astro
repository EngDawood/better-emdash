---
import HomePage from "../../components/HomePage.astro";
import { locales, type Locale, defaultLocale } from "../../i18n/utils";

// In server mode, validate locale from params
const { locale: localeParam } = Astro.params;

// Redirect if invalid locale
if (!locales.includes(localeParam as Locale)) {
	return Astro.redirect("/", 302);
}

// The default locale homepage lives unprefixed at `/`
if (localeParam === defaultLocale) {
	return Astro.redirect("/", 301);
}

const locale = localeParam as Locale;
---

<HomePage locale={locale} />
