---
import {
	getEmDashEntry,
	getEmDashCollection,
	getEntryTerms,
	getTermsForEntries,
	getSeoMeta,
	getSiteSettings,
	getWidgetArea,
} from "emdash";
import {
	Image,
	PortableText,
	Comments,
	CommentForm,
	WidgetArea,
} from "emdash/ui";
import Base from "../../../layouts/Base.astro";
import CustomBlock from "../../../components/CustomBlock.astro";
import PostCard from "../../../components/PostCard.astro";
import NewsletterSignup from "../../../components/NewsletterSignup.astro";
import { getReadingTime } from "../../../utils/reading-time";
import { locales, type Locale, defaultLocale, t } from "../../../i18n/utils";

// Validate locale
const { locale: localeParam, slug } = Astro.params;
const locale: Locale = locales.includes(localeParam as Locale)
	? (localeParam as Locale)
	: defaultLocale;

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.rewrite("/404");
}

Astro.cache.set(cacheHint);

function getImageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http")
			? image.src
			: `${Astro.url.origin}${image.src}`;
	}
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	if (storageKey) {
		return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`;
	}
	return undefined;
}

const [settings, tags, { entries: recentPosts }, newsletterPostArea] = await Promise.all([
	getSiteSettings(),
	getEntryTerms("posts", post.data.id, "tag"),
	getEmDashCollection("posts", { locale, orderBy: { published_at: "desc" }, limit: 8 }),
	getWidgetArea("newsletter-post"),
]);
const siteTitle = settings?.title || "Studio";
const featuredImageUrl = getImageUrl(post.data.featured_image);

const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/${locale}/blog/${slug}`,
	defaultOgImage: featuredImageUrl,
});

const bylines = post.data.bylines ?? [];
const leadByline = bylines[0];
const readingTime = getReadingTime(post.data.content);

// The design shows two recirculation blocks: an inline "read also" list inside
// the article, then a "related posts" grid at the foot. Split one query so a
// post never shows up in both.
const otherPosts = recentPosts.filter((p) => p.id !== post.id);
const readAlso = otherPosts.slice(0, 3);
const relatedPosts = otherPosts.slice(3, 6);

const relatedTagsMap = await getTermsForEntries(
	"posts",
	relatedPosts.map((p) => p.data.id),
	"tag"
);
const relatedWithTags = relatedPosts.map((p) => ({
	post: p,
	tags: relatedTagsMap.get(p.data.id) ?? [],
	bylines: p.data.bylines ?? [],
}));

const dateFormat: Intl.DateTimeFormatOptions = {
	year: "numeric",
	month: "long",
	day: "numeric",
};
const dateLocale = locale === "ar" ? "ar-SA" : "en-US";

const publishDate =
	post.data.publishedAt?.toLocaleDateString(dateLocale, dateFormat) ?? null;
const updatedDate = post.data.updatedAt.toLocaleDateString(
	dateLocale,
	dateFormat
);
// Only surface "last updated" when it actually differs from the publish date.
const showUpdated = Boolean(publishDate) && updatedDate !== publishDate;

const coverAlt = post.data.featured_image?.alt;
---

<Base
	title={seo.title}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug }}
	locale={locale}
>
	<article class="article">
		{
			post.data.featured_image && (
				<figure class="article-cover" {...post.edit.featured_image}>
					<div class="cover-frame">
						<Image image={post.data.featured_image} />
					</div>
					{coverAlt && <figcaption class="cover-caption">{coverAlt}</figcaption>}
				</figure>
			)
		}

		<div class="article-grid">
			<aside class="rail rail-start">
				<div class="rail-sticky">
					{
						leadByline && (
							<div class="rail-byline">
								{leadByline.byline.avatarMediaId && (
									<img
										src={`/_emdash/api/media/file/${leadByline.byline.avatarMediaId}`}
										alt={leadByline.byline.displayName}
										class="byline-avatar"
										loading="lazy"
									/>
								)}
								<div class="byline-info">
									<span class="byline-name">{leadByline.byline.displayName}</span>
									{leadByline.roleLabel && (
										<span class="byline-role">{leadByline.roleLabel}</span>
									)}
								</div>
							</div>
						)
					}
					{
						bylines.length > 1 && (
							<p class="rail-coauthors">
								{t("writing.authors", locale)}:{" "}
								{bylines
									.slice(1)
									.map((credit) => credit.byline.displayName)
									.join("، ")}
							</p>
						)
					}
					{
						leadByline?.byline.bio && (
							<p class="rail-bio">{leadByline.byline.bio}</p>
						)
					}
					{
						tags.length > 0 && (
							<div class="rail-section">
								<div class="rail-label">{t("writing.tags", locale)}</div>
								<div class="rail-tags">
									{tags.map((tag) => (
										<a href={`/${locale}/tag/${tag.slug}`} class="rail-tag">
											{t(`taxonomy.${tag.slug}`, locale) !== `taxonomy.${tag.slug}`
												? t(`taxonomy.${tag.slug}`, locale)
												: tag.label}
										</a>
									))}
								</div>
							</div>
						)
					}
				</div>
			</aside>

			<div class="article-main">
				<header class="article-header">
					<h1 class="article-title" {...post.edit.title}>{post.data.title}</h1>
					{
						post.data.excerpt && (
							<p class="article-dek" {...post.edit.excerpt}>
								{post.data.excerpt}
							</p>
						)
					}

					{
						leadByline && (
							<div class="inline-byline">
								{leadByline.byline.avatarMediaId && (
									<img
										src={`/_emdash/api/media/file/${leadByline.byline.avatarMediaId}`}
										alt={leadByline.byline.displayName}
										class="byline-avatar"
										loading="lazy"
									/>
								)}
								<div class="byline-info">
									<span class="byline-name">{leadByline.byline.displayName}</span>
									{leadByline.roleLabel && (
										<span class="byline-role">{leadByline.roleLabel}</span>
									)}
								</div>
							</div>
						)
					}

					<div class="dateline">
						<div class="dateline-text">
							<span class="dateline-primary">
								{publishDate && <time datetime={post.data.publishedAt?.toISOString()}>{publishDate}</time>}
								{publishDate && <span class="dateline-sep">·</span>}
								<span>{readingTime} {t("writing.min", locale)}</span>
							</span>
							{
								showUpdated && (
									<span class="dateline-secondary">
										{t("writing.updated", locale)}{" "}
										<time datetime={post.data.updatedAt.toISOString()}>{updatedDate}</time>
									</span>
								)
							}
						</div>
						<button
							type="button"
							class="pill-btn"
							data-share
							data-copied={t("writing.linkCopied", locale)}
						>
							{t("writing.share", locale)}
						</button>
					</div>
				</header>

				<div class="article-content" dir="auto">
					<PortableText
						value={post.data.content}
						components={{ type: { customBlock: CustomBlock } }}
					/>
				</div>

				{
					readAlso.length > 0 && (
						<aside class="read-also">
							<h2 class="rail-label">{t("writing.readAlso", locale)}</h2>
							<div class="read-also-list">
								{readAlso.map((p) => (
									<a href={`/${locale}/blog/${p.id}`} class="read-also-row">
										<div class="read-also-thumb">
											{p.data.featured_image && <Image image={p.data.featured_image} />}
										</div>
										<div class="read-also-body">
											<span class="read-also-title">{p.data.title}</span>
											{p.data.bylines?.[0] && (
												<span class="read-also-author">
													{p.data.bylines[0].byline.displayName}
												</span>
											)}
										</div>
									</a>
								))}
							</div>
						</aside>
					)
				}

				{newsletterPostArea && newsletterPostArea.widgets.length > 0 && (
					<NewsletterSignup locale={locale} />
				)}

				<div class="article-comments">
					<Comments collection="posts" contentId={post.data.id} threaded />
					<CommentForm collection="posts" contentId={post.data.id} />
				</div>
			</div>

			<aside class="rail rail-end">
				<div class="rail-sticky">
					<nav class="toc" aria-label={t("writing.onThisPage", locale)}>
						<div class="rail-label">{t("writing.onThisPage", locale)}</div>
						<div class="toc-content" id="toc-content"></div>
					</nav>
					<WidgetArea name="sidebar" />
				</div>
			</aside>
		</div>
	</article>

	{
		relatedWithTags.length > 0 && (
			<section class="more-posts">
				<div class="more-inner">
					<h2 class="rail-label">{t("writing.related", locale)}</h2>
					<div class="more-grid">
						{relatedWithTags.map(
							({ post: p, tags: postTags, bylines: postBylines }) => (
								<PostCard
									title={p.data.title}
									excerpt={p.data.excerpt}
									featuredImage={p.data.featured_image}
									href={`/${locale}/blog/${p.id}`}
									date={p.data.publishedAt ?? undefined}
									readingTime={getReadingTime(p.data.content)}
									tags={postTags.map((tag) => ({ slug: tag.slug, label: t(`taxonomy.${tag.slug}`, locale) !== `taxonomy.${tag.slug}` ? t(`taxonomy.${tag.slug}`, locale) : tag.label }))}
									bylines={postBylines}
									locale={locale}
								/>
							)
						)}
					</div>
				</div>
			</section>
		)
	}

	<script>
		function buildToc() {
			const content = document.querySelector(".article-content");
			const tocContainer = document.getElementById("toc-content");
			if (!content || !tocContainer) return;

			const headings = content.querySelectorAll("h2, h3");
			if (headings.length === 0) {
				const toc = document.querySelector(".toc") as HTMLElement | null;
				if (toc) toc.style.display = "none";
				return;
			}

			const list = document.createElement("ol");
			list.className = "toc-list";

			headings.forEach((heading, index) => {
				if (!heading.id) heading.id = `heading-${index}`;
				const li = document.createElement("li");
				li.className =
					heading.tagName === "H3" ? "toc-item toc-item--nested" : "toc-item";
				const link = document.createElement("a");
				link.href = `#${heading.id}`;
				link.className = "toc-link";
				link.textContent = heading.textContent;
				li.appendChild(link);
				list.appendChild(li);
			});

			tocContainer.appendChild(list);

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						const id = entry.target.id;
						const link = tocContainer.querySelector(`a[href="#${id}"]`);
						if (link && entry.isIntersecting) {
							tocContainer
								.querySelectorAll(".toc-link")
								.forEach((l) => l.classList.remove("active"));
							link.classList.add("active");
						}
					});
				},
				{ rootMargin: "-80px 0px -80% 0px" }
			);

			headings.forEach((heading) => observer.observe(heading));
		}

		function wireShare() {
			document.querySelectorAll<HTMLButtonElement>("[data-share]").forEach((btn) => {
				btn.addEventListener("click", async () => {
					const url = window.location.href;
					if (navigator.share) {
						try {
							await navigator.share({ title: document.title, url });
						} catch {
							/* user dismissed the share sheet */
						}
						return;
					}
					try {
						await navigator.clipboard.writeText(url);
						const original = btn.textContent;
						btn.textContent = btn.dataset.copied ?? original;
						setTimeout(() => {
							btn.textContent = original;
						}, 1600);
					} catch {
						/* clipboard unavailable — nothing useful to fall back to */
					}
				});
			});
		}

		buildToc();
		wireShare();
	</script>
</Base>

<style>
	.article {
		/* Inter in the source design; Thmanyah Sans is the self-hosted Arabic
		   equivalent already loaded by the site. */
		--ui: var(--font-sans);
	}

	:global(html[dir="rtl"]) .article,
	:global(html[dir="rtl"]) .more-posts {
		--ui: var(--font-arabic-sans);
	}

	.more-posts {
		--ui: var(--font-sans);
	}

	/* ── Cover ── */
	.article-cover {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-10) var(--spacing-6) 0;
	}

	.cover-frame {
		aspect-ratio: 1248 / 702;
		overflow: hidden;
		background: var(--color-bg-subtle);
	}

	.cover-frame :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.cover-caption {
		padding-top: var(--spacing-2);
		font-family: var(--ui);
		font-size: var(--font-size-xs);
		line-height: 1.5;
		color: var(--color-muted);
	}

	/* ── Editorial 10-column grid ── */
	.article-grid {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 3.5rem var(--spacing-6) 0;
		display: grid;
		grid-template-columns: repeat(10, 1fr);
		gap: var(--spacing-8);
		align-items: start;
	}

	.rail-start {
		grid-column: 1 / span 2;
	}

	.article-main {
		grid-column: 3 / span 6;
		min-width: 0;
	}

	.rail-end {
		grid-column: 9 / span 2;
	}

	.rail-sticky {
		position: sticky;
		top: calc(var(--nav-height) + var(--spacing-8));
	}

	/* ── Rail ── */
	.rail-byline {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
	}

	.byline-avatar {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
		background: var(--color-bg-subtle);
	}

	.byline-info {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.byline-name {
		font-family: var(--ui);
		font-size: 15px;
		font-weight: 500;
		line-height: 1.6;
		color: var(--color-text);
	}

	.byline-role {
		font-family: var(--ui);
		font-size: 12.5px;
		font-weight: 500;
		line-height: 1.45;
		color: var(--color-accent);
	}

	.rail-coauthors,
	.rail-bio {
		margin: var(--spacing-4) 0 0;
		font-family: var(--ui);
		font-size: 14.8px;
		line-height: 1.62;
		color: var(--color-text-secondary);
	}

	.rail-section {
		margin-top: var(--spacing-6);
		padding-top: var(--spacing-5);
		border-top: 1px solid var(--color-border-subtle);
	}

	.rail-label {
		font-family: var(--ui);
		font-size: var(--font-size-xs);
		font-weight: 500;
		line-height: 1.5;
		color: var(--color-muted);
		margin: 0 0 var(--spacing-3);
	}

	.rail-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.rail-tag {
		font-family: var(--ui);
		font-size: var(--font-size-xs);
		padding: 3px 9px;
		border-radius: var(--radius);
		background: var(--color-bg-subtle);
		color: var(--color-text-secondary);
		text-decoration: none;
		transition: color var(--transition-fast), background var(--transition-fast);
	}

	.rail-tag:hover {
		color: var(--color-text);
		background: var(--color-border);
	}

	/* ── Header ── */
	.article-title {
		margin: 0;
		font-size: 45px;
		font-weight: 700;
		line-height: 1.28;
		letter-spacing: 0;
		text-wrap: pretty;
	}

	.article-dek {
		margin: var(--spacing-5) 0 0;
		font-family: var(--ui);
		font-size: 21.8px;
		line-height: 1.45;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	.inline-byline {
		display: none;
		margin-top: var(--spacing-6);
		align-items: center;
		gap: var(--spacing-3);
	}

	.inline-byline .byline-avatar {
		width: 36px;
		height: 36px;
	}

	.dateline {
		margin-top: var(--spacing-5);
		padding: var(--spacing-3) 0;
		border-bottom: 1px solid var(--color-border);
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--spacing-4);
		flex-wrap: wrap;
	}

	.dateline-text {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-1);
	}

	.dateline-primary {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
		font-family: var(--ui);
		font-size: 15.5px;
		line-height: 1.55;
		color: var(--color-text);
	}

	.dateline-sep {
		color: var(--color-muted);
	}

	.dateline-secondary {
		font-family: var(--ui);
		font-size: 13.5px;
		line-height: 1.55;
		color: var(--color-muted);
	}

	.pill-btn {
		font-family: var(--ui);
		font-size: 13px;
		padding: 7px 14px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: transparent;
		color: var(--color-text-secondary);
		cursor: pointer;
		transition: color var(--transition-fast), border-color var(--transition-fast);
	}

	.pill-btn:hover {
		color: var(--color-text);
		border-color: var(--color-muted);
	}

	/* ── Body ── */
	.article-content {
		font-size: 18px;
		line-height: 1.85;
	}

	.article-content :global(p) {
		margin: 0 0 1.15em;
		unicode-bidi: plaintext;
	}

	.article-content :global(h2) {
		font-size: 29.2px;
		font-weight: 700;
		line-height: 1.38;
		margin: 2.35em 0 0.55em;
		scroll-margin-top: calc(var(--nav-height) + var(--spacing-4));
		unicode-bidi: plaintext;
	}

	.article-content :global(h3) {
		font-family: var(--ui);
		font-size: 18px;
		font-weight: 600;
		line-height: 1.6;
		margin: 1.8em 0 0.4em;
		scroll-margin-top: calc(var(--nav-height) + var(--spacing-4));
		unicode-bidi: plaintext;
	}

	.article-content :global(blockquote) {
		margin: 2em 0;
		padding: var(--spacing-6) 28px;
		background: var(--color-bg-subtle);
		border-inline-start: 3px solid var(--color-accent);
		color: var(--color-text-secondary);
		font-size: 20px;
		line-height: 1.7;
	}

	.article-content :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	.article-content :global(pre) {
		margin: 1.35em 0;
		padding: var(--spacing-5);
		background: var(--color-surface);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: 13.5px;
		line-height: 1.75;
		color: var(--color-text-secondary);
		direction: ltr;
		text-align: left;
	}

	.article-content :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--color-surface);
		padding: 0.2em 0.4em;
		border-radius: var(--radius);
	}

	.article-content :global(pre code) {
		background: none;
		padding: 0;
	}

	.article-content :global(ul),
	.article-content :global(ol) {
		margin: 0 0 1.15em;
		padding-inline-start: 22px;
	}

	.article-content :global(li) {
		margin-bottom: 0.45em;
	}

	.article-content :global(img) {
		margin: 2em 0;
	}

	.article-content :global(hr) {
		margin: 3em 0;
		border: none;
		border-top: 1px solid var(--color-border);
	}

	.article-content :global(a) {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* ── Inline "read also" ── */
	.read-also {
		margin-top: 2.45rem;
		padding: var(--spacing-6) 0;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.read-also .rail-label {
		margin-bottom: var(--spacing-5);
	}

	.read-also-list {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-5);
	}

	.read-also-row {
		display: flex;
		gap: var(--spacing-4);
		align-items: center;
		text-decoration: none;
		color: inherit;
	}

	.read-also-thumb {
		width: 80px;
		height: 80px;
		flex-shrink: 0;
		overflow: hidden;
		background: var(--color-bg-subtle);
